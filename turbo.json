{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "LOG_LEVEL",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_ADMIN_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": [".test-logs/**"]
    },
    "test:adapters": {},
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["CI", "HOME", "NEXT_TELEMETRY_DISABLED", "PLAYWRIGHT_BROWSERS_PATH"]
}
