# Copy to .env for local development. Synthetic data only.
LOG_LEVEL=info
# local | preview | staging | production (synthetic seeding is refused in production)
CLEANPOST_ENV=local
# Preview only: offer "Skip for now" on two-factor setup (refused unless CLEANPOST_ENV is local or preview)
PREVIEW_ALLOW_SKIP_2FA=false

# Web app and worker connect as the non-owner role so RLS always applies.
DATABASE_URL=postgres://cleanpost_web:cleanpost_web@localhost:5432/cleanpost
# Migrations and the system role only.
DATABASE_ADMIN_URL=postgres://cleanpost:cleanpost@localhost:5432/cleanpost

# Tests use a separate database.
TEST_DATABASE_URL=postgres://cleanpost_web:cleanpost_web@localhost:5432/cleanpost_test
TEST_DATABASE_ADMIN_URL=postgres://cleanpost:cleanpost@localhost:5432/cleanpost_test

# Field-level encryption for tax IDs and member IDs: 32 random bytes, base64
FIELD_ENCRYPTION_KEY=

# Auth
BETTER_AUTH_SECRET=change-me-to-32-random-bytes-base64
APP_URL=http://localhost:3000

# Email (Mailpit locally). SMTP_HOST=log only logs that an email would be sent.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Cleanpost <no-reply@cleanpost.local>"

# Next.js usage telemetry off
NEXT_TELEMETRY_DISABLED=1

# Mock PM (apps/pm-mock), local and preview only. It keeps its tables in its own pm_mock schema.
PM_MOCK_DATABASE_URL=postgres://cleanpost:cleanpost@localhost:5432/cleanpost
PM_MOCK_URL=http://localhost:4010
# Mock PM account API keys are derived from this secret (at least 24 characters).
PM_MOCK_SECRET=
# Basic-auth password (user "admin") for the mock PM's admin page at /admin; off when empty.
PM_MOCK_ADMIN_PASSWORD=
