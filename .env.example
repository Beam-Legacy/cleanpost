# Copy to .env for local development. Synthetic data only.
NODE_ENV=development
LOG_LEVEL=info

# Web app and worker connect as the non-owner role so RLS always applies.
DATABASE_URL=postgres://cleanpost_web:cleanpost_web@localhost:5432/cleanpost
# Migrations and the system role only.
DATABASE_ADMIN_URL=postgres://cleanpost:cleanpost@localhost:5432/cleanpost

# Tests use a separate database.
TEST_DATABASE_URL=postgres://cleanpost_web:cleanpost_web@localhost:5432/cleanpost_test
TEST_DATABASE_ADMIN_URL=postgres://cleanpost:cleanpost@localhost:5432/cleanpost_test

# Auth
BETTER_AUTH_SECRET=change-me-to-32-random-bytes-base64
APP_URL=http://localhost:3000

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Cleanpost <no-reply@cleanpost.local>"
