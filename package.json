{
  "name": "cleanpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm scan:logs",
    "test:e2e": "turbo run test:e2e",
    "test:adapters": "turbo run test:adapters",
    "db:up": "docker compose up -d postgres mailpit",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cleanpost/db run migrate",
    "seed": "pnpm --filter @cleanpost/seed run seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:logs": "pnpm --filter @cleanpost/testing run scan:logs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
